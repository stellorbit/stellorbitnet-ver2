{
  "name": "stellorbitnet",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "prebuild": "pnpm run prepare:posts",
    "precheck": "pnpm run prepare:posts",
    "preview": "astro preview",
    "astro": "astro",
    "cms": "node ./scripts/dev-cms.mjs",
    "cms:app": "node ./scripts/run-cms-gui.mjs",
    "cms:app:rebuild": "cargo build --manifest-path src-tauri/Cargo.toml",
    "cms:app:build": "node ./scripts/run-tauri.mjs build",
    "cms:app:dev": "node ./scripts/run-tauri.mjs dev",
    "new:post": "node ./scripts/new-astro-post.mjs",
    "new:post:interactive": "node ./scripts/new-astro-post.mjs --interactive",
    "sync:post-headings": "node ./scripts/sync-astro-post-headings.mjs",
    "check:images": "node ./scripts/check-image-references.mjs",
    "prepare:posts": "pnpm run sync:post-headings && pnpm run check:images",
    "docs:pdf": "node ./scripts/build-post-workflow-pdf.mjs",
    "deploy": "pnpm run build && node ./scripts/deploy-pages.mjs",
    "deploy:skip-build": "node ./scripts/deploy-pages.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:cms": "node ./scripts/verify-cms-playwright.mjs"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tauri-apps/api": "^2.11.1",
    "astro": "^7.4.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "sharp@0.33.5": true,
    "sharp@0.35.3": true,
    "sharp@0.35.4": true,
    "workerd@1.20260730.1": true,
    "workerd@1.20260911.1": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.12",
      "smol-toml": ">=1.9.0",
      "source-map-js": ">=1.2.2",
      "fast-uri": ">=3.1.8"
    }
  }
}
