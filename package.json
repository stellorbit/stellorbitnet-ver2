{
  "name": "stellorbitnet",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "prebuild": "npm run prepare:posts",
    "precheck": "npm run prepare:posts",
    "preview": "astro preview",
    "astro": "astro",
    "cms": "node ./scripts/dev-cms.mjs",
    "new:post": "node ./scripts/new-astro-post.mjs",
    "new:post:interactive": "node ./scripts/new-astro-post.mjs --interactive",
    "sync:post-headings": "node ./scripts/sync-astro-post-headings.mjs",
    "check:images": "node ./scripts/check-image-references.mjs",
    "prepare:posts": "npm run sync:post-headings && npm run check:images",
    "docs:pdf": "node ./scripts/build-post-workflow-pdf.mjs",
    "deploy": "npm run build && node ./scripts/deploy-pages.mjs",
    "deploy:skip-build": "node ./scripts/deploy-pages.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.4",
    "pnpm": "^10.33.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-toc": "^9.0.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "wrangler": "^4.83.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260603.1": true
  }
}
