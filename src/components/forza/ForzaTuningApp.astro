  .fh-badge-phase {
    background: rgba(255, 255, 255, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .fh-progress-text {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.8);
    margin-left: auto;
  }

  .fh-progress-track {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .fh-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #b06a43, #f5a623);
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  .fh-milestone-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    flex-wrap: wrap;
  }

  .m-label {
    color: rgba(255, 255, 255, 0.5);
    margin-right: 0.35rem;
  }

  .milestone-next {
    width: 100%;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.82rem;
  }

  .next-tag {
    color: #f5a623;
    font-weight: 700;
    margin-right: 0.4rem;
  }

  /* Mode Switcher */
  .fh-mode-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .mode-toggle-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: #ffffff;
    border: 2px solid var(--line);
    border-radius: 16px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-soft);
  }

  .mode-toggle-btn:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .mode-toggle-btn.active {
    background: linear-gradient(135deg, rgba(176, 106, 67, 0.08), rgba(255, 255, 255, 0.95));
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(176, 106, 67, 0.2);
  }

  .mode-icon {
    font-size: 2.2rem;
  }

  .mode-title {
    display: block;
    font-size: 1.15rem;
    color: var(--ink-strong);
    margin-bottom: 0.2rem;
  }

