    display: flex;
    flex-direction: column;
    gap: 2rem;
    font-family: inherit;
  }

  /* Header & Version Status Banner */
  .fh-header-panel {
    background: linear-gradient(135deg, rgba(35, 27, 22, 0.95), rgba(58, 42, 33, 0.95));
    border: 1px solid rgba(176, 106, 67, 0.3);
    border-radius: 20px;
    padding: 1.5rem 1.75rem;
    color: #fffdf9;
    box-shadow: 0 12px 30px rgba(35, 27, 22, 0.25);
  }

  .fh-version-badge-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .fh-version-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(176, 106, 67, 0.25);
    border: 1px solid rgba(176, 106, 67, 0.6);
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    color: #f7cbac;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
