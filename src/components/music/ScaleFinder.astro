---
---

<div class="scale-app">
  <!-- Mode Navigation Header -->
  <div class="app-mode-tabs">
    <button id="tab-reverse" class="mode-tab active" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      耳コピ逆引き検索（音名・鍵盤指定）
    </button>
    <button id="tab-explore" class="mode-tab" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      スケール検索・参照（ドロップダウン）
    </button>
  </div>

  <!-- SECTION 1: REVERSE LOOKUP MODE -->
  <section id="panel-reverse" class="app-panel active">
    <div class="card-box">
      <div class="card-box__header">
        <h2 class="card-box__title">
          <span class="badge badge--accent">耳コピ支援</span> 拾った音からスケールを特定する
        </h2>
        <p class="card-box__desc">
          耳で聴き取った音を「鍵盤をクリック」するか「テキスト欄に直接タイピング（例: C E G Bb / ド ミ ソ）」してください。適合するスケールを一覧表示します。
        </p>
      </div>

      <div class="input-section">
        <label for="reverse-text-input" class="form-label">
          <strong>音名テキスト入力:</strong>
          <span class="text-muted">(スペースやカンマ区切り。英語 `C D Eb` や和名 `ド ミ ソ` に対応)</span>
        </label>
        <div class="text-input-row">
          <input
            type="text"
            id="reverse-text-input"
            class="text-input"
            placeholder="例: C E G Bb または ド ミ ソ シb"
            autocomplete="off"
          />
          <button id="btn-clear-selection" class="btn btn--outline" type="button">選択解除</button>
        </div>

        <div class="quick-presets">
          <span class="preset-label">クイック試行:</span>
          <button class="btn-chip" data-preset="0,4,7" type="button">C メジャー (C E G)</button>
          <button class="btn-chip" data-preset="0,3,7,10" type="button">Cm7 (C Eb G Bb)</button>
          <button class="btn-chip" data-preset="0,4,7,10" type="button">C7 (C E G Bb)</button>
          <button class="btn-chip" data-preset="9,0,2,4,7" type="button">Amペンタ (A C D E G)</button>
        </div>
      </div>

      <!-- Piano Roll for Reverse Lookup -->
      <div class="reverse-piano-container">
        <p class="piano-title">鍵盤をクリックして音を選択 (トグル):</p>
        <div class="piano-keyboard" id="reverse-piano">
          <!-- JS generates octave 4 & 5 keys -->
        </div>
      </div>

      <!-- Results Display -->
      <div class="reverse-results-container">
        <div class="results-header">
          <h3>該当スケール候補 <span id="match-count-badge" class="count-tag">0件</span></h3>
          <div class="accidental-toggle">
            <span class="toggle-label">表記:</span>
            <button id="btn-accidental-sharp" class="toggle-btn active" type="button">♯ (シャープ)</button>
            <button id="btn-accidental-flat" class="toggle-btn" type="button">♭ (フラット)</button>
          </div>
        </div>

        <div id="reverse-results-list" class="results-grid">
          <div class="empty-state">
            音を選択またはテキストに入力すると、一致するスケール候補がここに表示されます。
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: SCALE EXPLORER / SEARCH MODE -->
  <section id="panel-explore" class="app-panel">
    <div class="card-box">
      <!-- Search & Controls Bar -->
      <div class="explorer-controls">
        <!-- Root Note Selector (Piano Roll Keyboard UI) -->
        <div class="control-group">
          <label class="form-label"><strong>ルート音 (主音) 選択 (鍵盤をクリック):</strong></label>
          <div class="root-piano-container">
            <div class="piano-keyboard piano-keyboard--root" id="root-buttons-container">
              <!-- JS generates 1 octave piano keys -->
            </div>
          </div>
        </div>

        <!-- Searchable Scale Dropdown -->
        <div class="control-group control-group--flex">
          <label for="scale-search-input" class="form-label"><strong>スケール検索・選択 (入力で絞り込み):</strong></label>
          <div class="custom-dropdown" id="custom-scale-dropdown">
            <div class="dropdown-trigger" id="dropdown-trigger">
              <span id="selected-scale-display">C メジャー・スケール (長音階 / アイオニアン)</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <div class="dropdown-menu" id="dropdown-menu">
              <div class="dropdown-search-box">
                <input
                  type="text"
                  id="scale-search-input"
                  placeholder="スケール名・タグで検索 (例: ドリアン, blues, 和風, 5音)..."
                  autocomplete="off"
                />
              </div>
              <div class="dropdown-options" id="dropdown-options-list">
                <!-- JS renders options categorized -->
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Scale Detailed Info Banner -->
      <div class="scale-info-banner" id="scale-info-banner">
        <div class="banner-main">
          <span class="category-badge" id="scale-category-badge">基本スケール</span>
          <h2 class="scale-title" id="scale-title-display">C Major Scale</h2>
          <p class="scale-desc" id="scale-desc-display">ポピュラー音楽の基本となる明るく安定した基本スケール。</p>
          <div class="scale-tags" id="scale-tags-display"></div>
        </div>
        <div class="banner-actions">
          <button id="btn-play-scale" class="btn btn--primary btn--lg" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            スケールを再生
          </button>
          <div class="sound-settings">
            <select id="synth-sound-select" class="select-input">
              <option value="sine">温かいシンセ (Sine)</option>
              <option value="triangle" selected>エレピ調 (Triangle)</option>
              <option value="sawtooth">リードシンセ (Sawtooth)</option>
              <option value="organ">オルガン風 (Organ)</option>
            </select>
            <div class="bpm-control">
              <span>BPM:</span>
              <input type="range" id="bpm-slider" min="60" max="220" value="120" />
              <span id="bpm-val">120</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Piano Keyboard Visualizer -->
      <div id="viz-piano-wrapper" class="viz-wrapper active">
        <div class="piano-roll-container">
          <h3 class="section-title">スケール構成音 (ピアノキーボード)</h3>
          <div class="piano-keyboard piano-keyboard--large" id="explorer-piano">
            <!-- JS renders 2 octaves -->
          </div>
        </div>
      </div>

      <!-- Scale Degree & Formula Breakdown Table -->
      <div class="formula-section">
        <h3>構成音一覧</h3>
        <div class="degree-chips-grid" id="degree-chips-container">
          <!-- JS renders chips -->
        </div>
      </div>

      <!-- Diatonic Chords Section -->
      <div class="chords-section">
        <div class="chords-section-header">
          <div>
            <h3>ダイアトニック・コード (Diatonic Chords)</h3>
            <p class="section-lead">このスケールの上に成り立つコードの一覧です。クリックで試聴できます。</p>
          </div>
          <div class="chord-controls-wrap">
            <div class="chord-type-toggle">
              <button id="btn-chord-triad" class="toggle-btn active" type="button">3和音 (トライアード)</button>
              <button id="btn-chord-seventh" class="toggle-btn" type="button">4和音 (セブンス)</button>
            </div>
            <button id="btn-export-midi" class="btn btn--sm btn--primary" type="button">
              🎹 MIDI一括ダウンロード (.mid)
            </button>
          </div>
        </div>
        <div class="chords-grid" id="diatonic-chords-container">
          <!-- JS renders chord cards -->
        </div>
      </div>
    </div>
  </section>

  <!-- SNS Share Section -->
  <div class="share-section">
    <div class="share-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
      <span>このツールを共有・シェアする</span>
    </div>
    <div class="share-buttons">
      <!-- X (Twitter) -->
      <button id="btn-share-x" class="share-btn share-btn--x" type="button" title="X (Twitter) で共有">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span>X で共有</span>
      </button>

      <!-- Instagram -->
      <button id="btn-share-instagram" class="share-btn share-btn--instagram" type="button" title="Instagram 用にリンクをコピー">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        <span>Instagram</span>
      </button>

      <!-- Misskey -->
      <button id="btn-share-misskey" class="share-btn share-btn--misskey" type="button" title="Misskey で共有">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-5l-2.5 2.5L7 12.5l4-4 4 4-1.5 1.5L11 11.5v5z"/></svg>
        <span>Misskey で共有</span>
      </button>

      <!-- Copy Link -->
      <button id="btn-share-copy" class="share-btn share-btn--copy" type="button" title="URLをコピー">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        <span id="copy-btn-text">リンクをコピー</span>
      </button>
    </div>
    <div id="share-toast" class="share-toast" aria-hidden="true"></div>
  </div>
</div>

<script>
  import {
    SCALES,
    NOTES_SHARP,
    NOTES_FLAT,
    CATEGORY_LABELS,
    parseNoteInput,
    getNoteName,
    getScalePitches,
    findMatchingScales,
    getDiatonicChords,
    type ScaleDef
  } from '../../lib/music/scaleData';
  import { generateDiatonicMidi, downloadMidiFile } from '../../lib/music/midiExporter';

  // --- STATE ---
  let activeTab: 'reverse' | 'explore' = 'reverse';
  let useFlats = false;
  let selectedReversePitches: Set<number> = new Set();
  
  let currentRootNote = 0; // C
  let currentScaleId = 'major';
  let chordType: 'triad' | 'seventh' = 'triad';

  // Web Audio Synth
  let audioCtx: AudioContext | null = null;
  let isPlayingScale = false;

  function getAudioContext(): AudioContext {
    if (!audioCtx) {
      const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
      audioCtx = new AudioCtxClass();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // --- DOM ELEMENTS ---
  const tabReverse = document.getElementById('tab-reverse')!;
  const tabExplore = document.getElementById('tab-explore')!;
  const panelReverse = document.getElementById('panel-reverse')!;
  const panelExplore = document.getElementById('panel-explore')!;

  const reverseTextInput = document.getElementById('reverse-text-input') as HTMLInputElement;
  const btnClearSelection = document.getElementById('btn-clear-selection')!;
  const reversePiano = document.getElementById('reverse-piano')!;
  const reverseResultsList = document.getElementById('reverse-results-list')!;
  const matchCountBadge = document.getElementById('match-count-badge')!;

  const btnAccidentalSharp = document.getElementById('btn-accidental-sharp')!;
  const btnAccidentalFlat = document.getElementById('btn-accidental-flat')!;

  // Explorer DOMs
  const rootButtonsContainer = document.getElementById('root-buttons-container')!;
  const customScaleDropdown = document.getElementById('custom-scale-dropdown')!;
  const dropdownTrigger = document.getElementById('dropdown-trigger')!;
  const dropdownMenu = document.getElementById('dropdown-menu')!;
  const selectedScaleDisplay = document.getElementById('selected-scale-display')!;
  const scaleSearchInput = document.getElementById('scale-search-input') as HTMLInputElement;
  const dropdownOptionsList = document.getElementById('dropdown-options-list')!;

  const scaleCategoryBadge = document.getElementById('scale-category-badge')!;
  const scaleTitleDisplay = document.getElementById('scale-title-display')!;
  const scaleDescDisplay = document.getElementById('scale-desc-display')!;
  const scaleTagsDisplay = document.getElementById('scale-tags-display')!;

  const btnPlayScale = document.getElementById('btn-play-scale') as HTMLButtonElement;
  const synthSoundSelect = document.getElementById('synth-sound-select') as HTMLSelectElement;
  const bpmSlider = document.getElementById('bpm-slider') as HTMLInputElement;
  const bpmVal = document.getElementById('bpm-val')!;

  const explorerPiano = document.getElementById('explorer-piano')!;
  const degreeChipsContainer = document.getElementById('degree-chips-container')!;
  const diatonicChordsContainer = document.getElementById('diatonic-chords-container')!;

  const btnChordTriad = document.getElementById('btn-chord-triad')!;
  const btnChordSeventh = document.getElementById('btn-chord-seventh')!;
  const btnExportMidi = document.getElementById('btn-export-midi')!;

  // --- INITIALIZATION ---
  function init() {
    setupTabSwitching();
    setupReverseMode();
    setupExplorerMode();
    setupAudioSynth();
    setupShareButtons();
    renderRootButtons();
    renderDropdownOptions();
    updateExplorerUI();
  }

  function setupShareButtons() {
    const btnShareX = document.getElementById('btn-share-x');
    const btnShareInstagram = document.getElementById('btn-share-instagram');
    const btnShareMisskey = document.getElementById('btn-share-misskey');
    const btnShareCopy = document.getElementById('btn-share-copy');
    const copyBtnText = document.getElementById('copy-btn-text');
    const shareToast = document.getElementById('share-toast');

    const shareTitle = '音楽のスケール検索＆耳コピ逆引きツール | stellorbit';

    function getShareUrl() {
      return window.location.href;
    }

    function showToast(msg: string) {
      if (!shareToast) return;
      shareToast.textContent = msg;
      shareToast.classList.add('show');
      setTimeout(() => {
        shareToast.classList.remove('show');
      }, 3000);
    }

    // X (Twitter)
    btnShareX?.addEventListener('click', () => {
      const url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(getShareUrl())}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });

    // Instagram (Copies URL & displays feedback message)
    btnShareInstagram?.addEventListener('click', () => {
      navigator.clipboard.writeText(getShareUrl()).then(() => {
        showToast('Instagram用にURLをコピーしました！投稿やストーリーズで共有できます。');
      }).catch(() => {
        showToast('URLのコピーに失敗しました。');
      });
    });

    // Misskey
    btnShareMisskey?.addEventListener('click', () => {
      const url = `https://misskey-share.gq/?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(getShareUrl())}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });

    // Copy Link
    btnShareCopy?.addEventListener('click', () => {
      navigator.clipboard.writeText(getShareUrl()).then(() => {
        if (copyBtnText) copyBtnText.textContent = 'コピー完了！';
        showToast('URLをクリップボードにコピーしました！');
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'リンクをコピー';
        }, 2000);
      }).catch(() => {
        showToast('URLのコピーに失敗しました。');
      });
    });
  }

  // Tab Navigation
  function setupTabSwitching() {
    tabReverse.addEventListener('click', () => switchTab('reverse'));
    tabExplore.addEventListener('click', () => switchTab('explore'));
  }

  function switchTab(tab: 'reverse' | 'explore') {
    activeTab = tab;
    if (tab === 'reverse') {
      tabReverse.classList.add('active');
      tabExplore.classList.remove('active');
      panelReverse.classList.add('active');
      panelExplore.classList.remove('active');
    } else {
      tabExplore.classList.add('active');
      tabReverse.classList.remove('active');
      panelExplore.classList.add('active');
      panelReverse.classList.remove('active');
    }
  }

  // --- REVERSE LOOKUP MODE IMPLEMENTATION ---
  function setupReverseMode() {
    // Build 2-octave piano for reverse lookup
    renderReversePiano();

    // Text Input Listener
    reverseTextInput.addEventListener('input', () => {
      const val = reverseTextInput.value;
      const pitches = parseNoteInput(val);
      selectedReversePitches = new Set(pitches);
      updateReversePianoHighlight();
      renderReverseResults();
    });

    // Clear Button
    btnClearSelection.addEventListener('click', () => {
      selectedReversePitches.clear();
      reverseTextInput.value = '';
      updateReversePianoHighlight();
      renderReverseResults();
    });

    // Accidental Toggles
    btnAccidentalSharp.addEventListener('click', () => {
      useFlats = false;
      btnAccidentalSharp.classList.add('active');
      btnAccidentalFlat.classList.remove('active');
      renderRootButtons();
      renderDropdownOptions();
      updateExplorerUI();
      renderReverseResults();
    });

    btnAccidentalFlat.addEventListener('click', () => {
      useFlats = true;
      btnAccidentalFlat.classList.add('active');
      btnAccidentalSharp.classList.remove('active');
      renderRootButtons();
      renderDropdownOptions();
      updateExplorerUI();
      renderReverseResults();
    });

    // Preset Buttons
    document.querySelectorAll('.btn-chip').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const preset = target.dataset.preset;
        if (preset) {
          const pitches = preset.split(',').map(Number);
          selectedReversePitches = new Set(pitches);
          syncReverseTextFromSet();
          updateReversePianoHighlight();
          renderReverseResults();
        }
      });
    });
  }

  function renderReversePiano() {
    reversePiano.innerHTML = '';

    const pianoTrack = document.createElement('div');
    pianoTrack.className = 'real-piano-track real-piano-track--1octave';

    const pitchMapping = [
      { pitch: 0, isBlack: false, whiteIdx: 0 },
      { pitch: 1, isBlack: true,  blackIdx: 1 },
      { pitch: 2, isBlack: false, whiteIdx: 1 },
      { pitch: 3, isBlack: true,  blackIdx: 2 },
      { pitch: 4, isBlack: false, whiteIdx: 2 },
      { pitch: 5, isBlack: false, whiteIdx: 3 },
      { pitch: 6, isBlack: true,  blackIdx: 4 },
      { pitch: 7, isBlack: false, whiteIdx: 4 },
      { pitch: 8, isBlack: true,  blackIdx: 5 },
      { pitch: 9, isBlack: false, whiteIdx: 5 },
      { pitch: 10, isBlack: true, blackIdx: 6 },
      { pitch: 11, isBlack: false, whiteIdx: 6 }
    ];

    // White keys first
    pitchMapping.filter(k => !k.isBlack).forEach(k => {
      const noteName = getNoteName(k.pitch, useFlats);
      const isSelected = selectedReversePitches.has(k.pitch);

      const keyEl = document.createElement('button');
      keyEl.type = 'button';
      keyEl.className = `piano-key-real white-key ${isSelected ? 'selected' : ''}`;
      keyEl.dataset.pitch = String(k.pitch);

      const label = document.createElement('span');
      label.className = 'key-label';
      label.textContent = noteName;
      keyEl.appendChild(label);

      keyEl.addEventListener('click', () => {
        playNoteSound(k.pitch, 4);
        if (selectedReversePitches.has(k.pitch)) {
          selectedReversePitches.delete(k.pitch);
        } else {
          selectedReversePitches.add(k.pitch);
        }
        syncReverseTextFromSet();
        updateReversePianoHighlight();
        renderReverseResults();
      });

      pianoTrack.appendChild(keyEl);
    });

    // Black keys second
    pitchMapping.filter(k => k.isBlack).forEach(k => {
      const noteName = getNoteName(k.pitch, useFlats);
      const isSelected = selectedReversePitches.has(k.pitch);

      const keyEl = document.createElement('button');
      keyEl.type = 'button';
      keyEl.className = `piano-key-real black-key ${isSelected ? 'selected' : ''}`;
      keyEl.dataset.pitch = String(k.pitch);
      keyEl.style.left = `calc(44px * ${k.blackIdx} - 14px)`;

      const label = document.createElement('span');
      label.className = 'key-label';
      label.textContent = noteName;
      keyEl.appendChild(label);

      keyEl.addEventListener('click', () => {
        playNoteSound(k.pitch, 4);
        if (selectedReversePitches.has(k.pitch)) {
          selectedReversePitches.delete(k.pitch);
        } else {
          selectedReversePitches.add(k.pitch);
        }
        syncReverseTextFromSet();
        updateReversePianoHighlight();
        renderReverseResults();
      });

      pianoTrack.appendChild(keyEl);
    });

    reversePiano.appendChild(pianoTrack);
  }

  function updateReversePianoHighlight() {
    const keys = reversePiano.querySelectorAll('.piano-key-real');
    keys.forEach((keyEl) => {
      const pitch = Number((keyEl as HTMLElement).dataset.pitch);
      if (selectedReversePitches.has(pitch)) {
        keyEl.classList.add('selected');
      } else {
        keyEl.classList.remove('selected');
      }
    });
  }

  function syncReverseTextFromSet() {
    const sorted = Array.from(selectedReversePitches).sort((a, b) => a - b);
    const names = sorted.map(p => getNoteName(p, useFlats));
    reverseTextInput.value = names.join(' ');
  }

  function renderReverseResults() {
    const pitches = Array.from(selectedReversePitches);
    if (pitches.length === 0) {
      matchCountBadge.textContent = '0件';
      reverseResultsList.innerHTML = `
        <div class="empty-state">
          鍵盤をクリックするかテキスト欄に音名を入力してください。音を含むスケールを一覧表示します。
        </div>
      `;
      return;
    }

    const matches = findMatchingScales(pitches, useFlats);
    matchCountBadge.textContent = `${matches.length}件`;

    if (matches.length === 0) {
      reverseResultsList.innerHTML = `<div class="empty-state">一致するスケールが見つかりませんでした。</div>`;
      return;
    }

    // Top 24 matching results
    const topMatches = matches.slice(0, 24);
    reverseResultsList.innerHTML = topMatches.map(m => {
      const is100 = m.matchPercentage === 100;
      const matchedNoteNames = pitches
        .filter(p => !m.missingNotesInScale.includes(p))
        .map(p => getNoteName(p, useFlats));
      
      const missingNoteNames = m.missingNotesInScale.map(p => getNoteName(p, useFlats));

      return `
        <div class="scale-result-card ${is100 ? 'scale-result-card--perfect' : ''}" data-root="${m.rootNote}" data-scale="${m.scale.id}">
          <div class="card-top">
            <span class="match-badge ${is100 ? 'match-badge--100' : ''}">${m.matchPercentage}% 一致</span>
            <span class="cat-tag">${CATEGORY_LABELS[m.scale.category]}</span>
          </div>
          <h4 class="scale-result-title">${m.rootName} ${m.scale.nameJa}</h4>
          <p class="scale-result-sub">${m.rootName} ${m.scale.nameEn}</p>
          
          <div class="notes-breakdown">
            <div class="note-row">
              <span class="row-label">含まれる選択音:</span>
              <div class="tags-wrap">
                ${matchedNoteNames.map(n => `<span class="note-chip note-chip--match">${n}</span>`).join('')}
              </div>
            </div>
            ${missingNoteNames.length > 0 ? `
              <div class="note-row">
                <span class="row-label">含まれない音:</span>
                <div class="tags-wrap">
                  ${missingNoteNames.map(n => `<span class="note-chip note-chip--missing">${n}</span>`).join('')}
                </div>
              </div>
            ` : ''}
          </div>

          <button class="btn btn--outline btn--sm btn-inspect-scale" type="button">
            このスケールを詳細表示 ➔
          </button>
        </div>
      `;
    }).join('');

    // Attach click events to inspect scale
    reverseResultsList.querySelectorAll('.scale-result-card').forEach(card => {
      card.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const root = Number(target.dataset.root);
        const scaleId = target.dataset.scale;
        if (scaleId) {
          currentRootNote = root;
          currentScaleId = scaleId;
          updateExplorerUI();
          switchTab('explore');
        }
      });
    });
  }

  // --- EXPLORER MODE IMPLEMENTATION ---
  function setupExplorerMode() {
    // Custom Dropdown toggle
    dropdownTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      customScaleDropdown.classList.toggle('open');
      if (customScaleDropdown.classList.contains('open')) {
        scaleSearchInput.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!customScaleDropdown.contains(e.target as Node)) {
        customScaleDropdown.classList.remove('open');
      }
    });

    scaleSearchInput.addEventListener('input', () => {
      renderDropdownOptions();
    });

    bpmSlider.addEventListener('input', () => {
      bpmVal.textContent = bpmSlider.value;
    });

    btnPlayScale.addEventListener('click', () => {
      if (isPlayingScale) return;
      playScaleSequence();
    });

    btnChordTriad.addEventListener('click', () => {
      chordType = 'triad';
      btnChordTriad.classList.add('active');
      btnChordSeventh.classList.remove('active');
      renderDiatonicChords();
    });

    btnChordSeventh.addEventListener('click', () => {
      chordType = 'seventh';
      btnChordSeventh.classList.add('active');
      btnChordTriad.classList.remove('active');
      renderDiatonicChords();
    });

    btnExportMidi.addEventListener('click', () => {
      const scale = SCALES.find(s => s.id === currentScaleId) || SCALES[0];
      const rootName = getNoteName(currentRootNote, useFlats);
      const chords = getDiatonicChords(scale, currentRootNote, useFlats);
      const bpm = Number(bpmSlider.value);

      const midiBytes = generateDiatonicMidi(chords, chordType, bpm);
      const shortScale = scale.id.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join('');
      const filename = `${rootName}_${shortScale}_${chordType === 'triad' ? '3Triad' : '4Seventh'}.mid`;
      downloadMidiFile(midiBytes, filename);
    });
  }

  function renderRootButtons() {
    rootButtonsContainer.innerHTML = '';

    const pianoTrack = document.createElement('div');
    pianoTrack.className = 'real-piano-track real-piano-track--1octave';

    const pitchMapping = [
      { pitch: 0, isBlack: false, whiteIdx: 0 },
      { pitch: 1, isBlack: true,  blackIdx: 1 },
      { pitch: 2, isBlack: false, whiteIdx: 1 },
      { pitch: 3, isBlack: true,  blackIdx: 2 },
      { pitch: 4, isBlack: false, whiteIdx: 2 },
      { pitch: 5, isBlack: false, whiteIdx: 3 },
      { pitch: 6, isBlack: true,  blackIdx: 4 },
      { pitch: 7, isBlack: false, whiteIdx: 4 },
      { pitch: 8, isBlack: true,  blackIdx: 5 },
      { pitch: 9, isBlack: false, whiteIdx: 5 },
      { pitch: 10, isBlack: true, blackIdx: 6 },
      { pitch: 11, isBlack: false, whiteIdx: 6 }
    ];

    // White keys first
    pitchMapping.filter(k => !k.isBlack).forEach(k => {
      const noteName = getNoteName(k.pitch, useFlats);
      const isSelected = k.pitch === currentRootNote;

      const keyEl = document.createElement('button');
      keyEl.type = 'button';
      keyEl.className = `piano-key-real white-key ${isSelected ? 'is-root active' : ''}`;
      keyEl.setAttribute('aria-label', `Root note ${noteName}`);

      const label = document.createElement('span');
      label.className = 'key-label';
      label.textContent = noteName;
      keyEl.appendChild(label);

      keyEl.addEventListener('click', () => {
        playNoteSound(k.pitch, 4);
        currentRootNote = k.pitch;
        renderRootButtons();
        updateExplorerUI();
      });

      pianoTrack.appendChild(keyEl);
    });

    // Black keys second
    pitchMapping.filter(k => k.isBlack).forEach(k => {
      const noteName = getNoteName(k.pitch, useFlats);
      const isSelected = k.pitch === currentRootNote;

      const keyEl = document.createElement('button');
      keyEl.type = 'button';
      keyEl.className = `piano-key-real black-key ${isSelected ? 'is-root active' : ''}`;
      keyEl.style.left = `calc(44px * ${k.blackIdx} - 14px)`;
      keyEl.setAttribute('aria-label', `Root note ${noteName}`);

      const label = document.createElement('span');
      label.className = 'key-label';
      label.textContent = noteName;
      keyEl.appendChild(label);

      keyEl.addEventListener('click', () => {
        playNoteSound(k.pitch, 4);
        currentRootNote = k.pitch;
        renderRootButtons();
        updateExplorerUI();
      });

      pianoTrack.appendChild(keyEl);
    });

    rootButtonsContainer.appendChild(pianoTrack);
  }

  function renderDropdownOptions() {
    const query = scaleSearchInput.value.trim().toLowerCase();
    dropdownOptionsList.innerHTML = '';

    const categories: Array<ScaleDef['category']> = ['diatonic', 'modes', 'pentatonic-blues', 'bebop-symmetric', 'exotic-world'];

    categories.forEach(cat => {
      const catScales = SCALES.filter(s => s.category === cat && (
        !query ||
        s.nameJa.toLowerCase().includes(query) ||
        s.nameEn.toLowerCase().includes(query) ||
        s.tags.some(t => t.toLowerCase().includes(query))
      ));

      if (catScales.length > 0) {
        const catHeader = document.createElement('div');
        catHeader.className = 'dropdown-cat-title';
        catHeader.textContent = CATEGORY_LABELS[cat];
        dropdownOptionsList.appendChild(catHeader);

        catScales.forEach(s => {
          const item = document.createElement('div');
          item.className = `dropdown-option ${s.id === currentScaleId ? 'selected' : ''}`;
          item.innerHTML = `
            <span class="option-title">${s.nameJa}</span>
            <span class="option-sub">${s.nameEn}</span>
          `;
          item.addEventListener('click', () => {
            currentScaleId = s.id;
            customScaleDropdown.classList.remove('open');
            renderDropdownOptions();
            updateExplorerUI();
          });
          dropdownOptionsList.appendChild(item);
        });
      }
    });

    if (dropdownOptionsList.children.length === 0) {
      dropdownOptionsList.innerHTML = `<div class="dropdown-no-result">検索結果がありません</div>`;
    }
  }

  function updateExplorerUI() {
    const scale = SCALES.find(s => s.id === currentScaleId) || SCALES[0];
    const rootName = getNoteName(currentRootNote, useFlats);

    // Banner
    selectedScaleDisplay.textContent = `${rootName} ${scale.nameJa}`;
    scaleCategoryBadge.textContent = CATEGORY_LABELS[scale.category];
    scaleTitleDisplay.textContent = `${rootName} ${scale.nameJa}`;
    scaleDescDisplay.textContent = scale.description;
    scaleTagsDisplay.innerHTML = scale.tags.map(t => `<span class="tag-pill">#${t}</span>`).join('');

    renderExplorerPiano();
    renderDegreeTable();
    renderDiatonicChords();
  }

  function renderExplorerPiano() {
    explorerPiano.innerHTML = '';

    const scale = SCALES.find(s => s.id === currentScaleId) || SCALES[0];
    const scalePitches = getScalePitches(scale, currentRootNote);
    const pitchSet = new Set(scalePitches);

    const pianoTrack = document.createElement('div');
    pianoTrack.className = 'real-piano-track real-piano-track--2octaves';

    const pitchMapping = [
      { pitchInOct: 0, isBlack: false, whiteIdx: 0 },
      { pitchInOct: 1, isBlack: true,  blackIdx: 1 },
      { pitchInOct: 2, isBlack: false, whiteIdx: 1 },
      { pitchInOct: 3, isBlack: true,  blackIdx: 2 },
      { pitchInOct: 4, isBlack: false, whiteIdx: 2 },
      { pitchInOct: 5, isBlack: false, whiteIdx: 3 },
      { pitchInOct: 6, isBlack: true,  blackIdx: 4 },
      { pitchInOct: 7, isBlack: false, whiteIdx: 4 },
      { pitchInOct: 8, isBlack: true,  blackIdx: 5 },
      { pitchInOct: 9, isBlack: false, whiteIdx: 5 },
      { pitchInOct: 10, isBlack: true, blackIdx: 6 },
      { pitchInOct: 11, isBlack: false, whiteIdx: 6 }
    ];

    for (let oct = 0; oct < 2; oct++) {
      // White keys
      pitchMapping.filter(k => !k.isBlack).forEach(k => {
        const pitchClass = k.pitchInOct;
        const noteName = getNoteName(pitchClass, useFlats);
        const isInScale = pitchSet.has(pitchClass);
        const isRoot = pitchClass === currentRootNote;

        const keyEl = document.createElement('button');
        keyEl.type = 'button';
        keyEl.className = `piano-key-real white-key ${isInScale ? 'in-scale' : ''} ${isRoot ? 'is-root' : ''}`;

        const label = document.createElement('span');
        label.className = 'key-label';
        label.textContent = noteName;
        keyEl.appendChild(label);

        keyEl.addEventListener('click', () => {
          playNoteSound(pitchClass, oct + 4);
        });

        pianoTrack.appendChild(keyEl);
      });

      // Black keys
      pitchMapping.filter(k => k.isBlack).forEach(k => {
        const pitchClass = k.pitchInOct;
        const noteName = getNoteName(pitchClass, useFlats);
        const globalBlackIdx = oct * 7 + k.blackIdx!;
        const isInScale = pitchSet.has(pitchClass);
        const isRoot = pitchClass === currentRootNote;

        const keyEl = document.createElement('button');
        keyEl.type = 'button';
        keyEl.className = `piano-key-real black-key ${isInScale ? 'in-scale' : ''} ${isRoot ? 'is-root' : ''}`;
        keyEl.style.left = `calc(44px * ${globalBlackIdx} - 14px)`;

        const label = document.createElement('span');
        label.className = 'key-label';
        label.textContent = noteName;
        keyEl.appendChild(label);

        keyEl.addEventListener('click', () => {
          playNoteSound(pitchClass, oct + 4);
        });

        pianoTrack.appendChild(keyEl);
      });
    }

    explorerPiano.appendChild(pianoTrack);
  }

  function renderDegreeTable() {
    degreeChipsContainer.innerHTML = '';
    const scale = SCALES.find(s => s.id === currentScaleId) || SCALES[0];
    const scalePitches = getScalePitches(scale, currentRootNote);

    scalePitches.forEach((p) => {
      const name = getNoteName(p, useFlats);
      const isRoot = p === currentRootNote;

      const chip = document.createElement('div');
      chip.className = `degree-chip ${isRoot ? 'is-root' : ''}`;
      chip.innerHTML = `
        <span class="note-val">${name}</span>
        ${isRoot ? '<span class="root-badge">Root</span>' : ''}
      `;
      degreeChipsContainer.appendChild(chip);
    });
  }

  function renderDiatonicChords() {
    diatonicChordsContainer.innerHTML = '';
    const scale = SCALES.find(s => s.id === currentScaleId) || SCALES[0];
    const chords = getDiatonicChords(scale, currentRootNote, useFlats);

    chords.forEach(c => {
      const card = document.createElement('div');
      card.className = 'chord-card';

      const mainName = chordType === 'triad' ? c.triadName : c.seventhName;
      const subName = chordType === 'triad' ? `セブンス: ${c.seventhName}` : `トライアード: ${c.triadName}`;
      const notesToPlay = chordType === 'triad' ? c.triadNotes : c.seventhNotes;

      card.innerHTML = `
        <div class="chord-degree">${c.degreeRoman} (${chordType === 'triad' ? '3和音' : '4和音'})</div>
        <div class="chord-names">
          <strong class="triad-name">${mainName}</strong>
          <span class="seventh-name">${subName}</span>
        </div>
        <div class="chord-card-actions">
          <button class="btn btn--sm btn--outline btn-play-chord" type="button">
            ▶ 試聴
          </button>
          <button class="btn btn--sm btn--outline btn-dl-chord-midi" type="button" title="このコードのMIDIを保存">
            💾 MIDI
          </button>
        </div>
      `;

      card.querySelector('.btn-play-chord')!.addEventListener('click', () => {
        playChordSound(notesToPlay);
      });

      card.querySelector('.btn-dl-chord-midi')!.addEventListener('click', () => {
        const bpm = Number(bpmSlider.value);
        const singleMidi = generateDiatonicMidi([c], chordType, bpm);
        const cleanName = mainName.replace(/♭/g, 'b').replace(/♯/g, '#');
        const filename = `${c.rootNoteName}_${c.degreeRoman}_${cleanName}.mid`;
        downloadMidiFile(singleMidi, filename);
      });

      diatonicChordsContainer.appendChild(card);
    });
  }

  // --- AUDIO SYNTH PLAYBACK ENGINE ---
  function setupAudioSynth() {
    // Resumes AudioContext on user interaction
    document.addEventListener('click', () => {
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }, { once: true });
  }

  function playNoteSound(pitchClass: number, octave = 4) {
    const ctx = getAudioContext();
    const type = synthSoundSelect.value as OscillatorType | 'organ';
    
    // Frequency formula: A4 = 440Hz -> pitchClass 9, Octave 4
    const midi = (octave + 1) * 12 + pitchClass;
    const freq = 440 * Math.pow(2, (midi - 69) / 12);

    const now = ctx.currentTime;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();

    if (type === 'organ') {
      osc.type = 'sine';
      // Harmonics for organ feel
      const osc2 = ctx.createOscillator();
      osc2.type = 'triangle';
      osc2.frequency.setValueAtTime(freq * 2, now);
      osc2.connect(gain);
      osc2.start(now);
      osc2.stop(now + 0.4);
    } else {
      osc.type = type as OscillatorType;
    }

    osc.frequency.setValueAtTime(freq, now);

    // Envelope
    gain.gain.setValueAtTime(0.01, now);
    gain.gain.exponentialRampToValueAtTime(0.25, now + 0.03);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.start(now);
    osc.stop(now + 0.5);
  }

  function playChordSound(pitchClasses: number[]) {
    if (pitchClasses.length === 0) return;
    const rootPitch = pitchClasses[0]; // Chord root is the 1st element

    pitchClasses.forEach((p) => {
      // Calculate semitone offset above chord root (0 to 11 semitones)
      const offset = (p - rootPitch + 12) % 12;
      // Absolute semitone index starting from Octave 4 Root
      const absoluteSemitones = 4 * 12 + rootPitch + offset;
      const octave = Math.floor(absoluteSemitones / 12);
      const pitchClass = absoluteSemitones % 12;

      playNoteSound(pitchClass, octave);
    });
  }

  function playScaleSequence() {
    isPlayingScale = true;
    btnPlayScale.disabled = true;
    const origText = btnPlayScale.innerHTML;
    btnPlayScale.innerHTML = `再生中...`;

    const scale = SCALES.find(s => s.id === currentScaleId) || SCALES[0];
    const pitches = getScalePitches(scale, currentRootNote);
    
    // Sequence: Scale up + Root of next octave, then down
    const seq = [...pitches, currentRootNote];
    const bpm = Number(bpmSlider.value);
    const intervalMs = (60 / bpm) * 1000 * 0.5; // 8th notes

    seq.forEach((p, idx) => {
      setTimeout(() => {
        const octave = (idx === seq.length - 1) ? 5 : 4;
        playNoteSound(p, octave);
      }, idx * intervalMs);
    });

    setTimeout(() => {
      isPlayingScale = false;
      btnPlayScale.disabled = false;
      btnPlayScale.innerHTML = origText;
    }, seq.length * intervalMs + 200);
  }

  // Run on load
  init();
</script>

