---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArticleShareBar from '../components/ArticleShareBar.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: ImageMetadata;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description = '',
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const heroImageURL = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;

// JSON-LD: BlogPosting
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href,
  },
  ...(heroImageURL ? { image: [heroImageURL] } : {}),
  author: {
    '@type': 'Person',
    name: 'ことねP',
    url: new URL('/about/', Astro.site).href,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: Astro.site?.href ?? 'https://stellorbit.net',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site).href,
    },
  },
};

// JSON-LD: BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.href ?? 'https://stellorbit.net',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '記事一覧',
      item: new URL('/posts/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalURL.href,
    },
  ],
};
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      article={{ pubDate, updatedDate }}
    />
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>

  <body>
    <Header />
    <main class="page-shell">
      <article class="post-sheet">
        <div class="hero-image">
          {
            heroImage && (
              <Image width={1020} height={510} src={heroImage} alt={title} priority />
            )
          }
        </div>
        <div class="post-body">
          <div class="post-heading">
            <div class="post-meta">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div>
                    更新: <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <p>{description}</p>
          </div>
          {headings.length > 0 && <TableOfContents headings={headings} />}
          <div class="prose">
            <slot />
          </div>
          <ArticleShareBar title={title} url={Astro.url.href} />
          <GiscusComments />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
