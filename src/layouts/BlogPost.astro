---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArticleShareBar from '../components/ArticleShareBar.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: ImageMetadata;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description ?? ''} />
  </head>

  <body>
    <Header />
    <main class="page-shell">
      <article class="post-sheet">
        <div class="hero-image">
          {
            heroImage && (
              <Image width={1020} height={510} src={heroImage} alt="" />
            )
          }
        </div>
        <div class="post-body">
          <div class="post-heading">
            <div class="post-meta">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div>
                    更新: <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <p>{description}</p>
          </div>
          // 要約ボタンのコンテナ
          <div class="summary-container">
            <button id="summarize-btn">この記事を要約する</button>
            <div id="summary-box"></div>
          </div>
          // ここまで要約ボタンのコンテナ
          {headings.length > 0 && <TableOfContents headings={headings} />}
          <div class="prose">
            <slot />
          </div>
          <ArticleShareBar title={title} url={Astro.url.href} />
          <GiscusComments />
        </div>
      </article>

      // 記事要約スクリプト部分

      <script>
        // Astro v4 では script は自動的にクライアント側で実行される
        document.addEventListener('DOMContentLoaded', () => {
          const btn = document.getElementById('summarize-btn');
          const box = document.getElementById('summary-box');

          if (!btn || !box) {
            console.warn('要約ボタンまたは summary-box が見つかりませんでした');
            return;
          }

          btn.addEventListener('click', async () => {
            const articleText =
              document.querySelector('article')?.innerText ?? '';
            box.textContent = '要約中…';

            try {
              const res = await fetch(
                'https://weathered-grass-58d9.shirube-factory.workers.dev',
                {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ text: articleText }),
                }
              );

              const data = await res.json();
              box.textContent = data.summary ?? '要約に失敗しました。';
            } catch (e) {
              box.textContent = '通信エラーが発生しました。';
            }
          });
        });
      </script>

      // ここまで記事要約スクリプト
    </main>
    <Footer />
  </body>
</html>
