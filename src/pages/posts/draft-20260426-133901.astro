---
import ArticleBody from '../../articles/draft-20260426-133901.astro';
import { getAstroPost } from '../../content/astro-posts';
import BlogPost from '../../layouts/BlogPost.astro';

const post = getAstroPost('draft-20260426-133901');

if (!post) {
	throw new Error('Astro post metadata not found: draft-20260426-133901');
}
---

<BlogPost
	title={post.title}
	description={post.description}
	pubDate={post.pubDate}
	updatedDate={post.updatedDate}
	headings={post.headings}
>
	<ArticleBody />
</BlogPost>