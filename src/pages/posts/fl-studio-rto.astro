---
import ArticleBody from '../../articles/fl-studio-rto.astro';
import { getAstroPost } from '../../content/astro-posts';
import BlogPost from '../../layouts/BlogPost.astro';

const post = getAstroPost('fl-studio-rto');

if (!post) {
	throw new Error('Astro post metadata not found: fl-studio-rto');
}
---

<BlogPost
	title={post.title}
	description={post.description}
	pubDate={post.pubDate}
	updatedDate={post.updatedDate}
	headings={post.headings}
>
	<ArticleBody />
</BlogPost>
