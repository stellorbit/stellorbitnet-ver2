---
import ArticleBody from '../../articles/pc-vs-ps5.astro';
import { getAstroPost } from '../../content/astro-posts';
import BlogPost from '../../layouts/BlogPost.astro';

const post = getAstroPost('pc-vs-ps5');

if (!post) {
	throw new Error('Astro post metadata not found: pc-vs-ps5');
}
---

<BlogPost
	title={post.title}
	description={post.description}
	pubDate={post.pubDate}
	updatedDate={post.updatedDate}
	headings={post.headings}
>
	<ArticleBody />
</BlogPost>
