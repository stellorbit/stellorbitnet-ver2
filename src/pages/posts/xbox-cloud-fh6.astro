---
import ArticleBody from '../../articles/xbox-cloud-fh6.astro';
import { getAstroPost } from '../../content/astro-posts';
import BlogPost from '../../layouts/BlogPost.astro';

const post = getAstroPost('xbox-cloud-fh6');

if (!post) {
	throw new Error('Astro post metadata not found: xbox-cloud-fh6');
}
---

<BlogPost
	title={post.title}
	description={post.description}
	pubDate={post.pubDate}
	updatedDate={post.updatedDate}
	headings={post.headings}
>
	<ArticleBody />
</BlogPost>
