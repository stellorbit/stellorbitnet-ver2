---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScaleFinder from '../components/music/ScaleFinder.astro';
---

<BaseLayout
	title="Tools - 作成ツール類"
	description="音楽のスケール検索＆耳コピ逆引きツール（Webアプリ）、ChordLaunchpad、Win11Optimizerなどの各種自作ツール集。"
>
	<div class="shell">
		<section class="content-panel">
			<div class="page-heading">
				<p class="eyebrow">Tools & Applications</p>
				<h1>作成ツール類</h1>
				<p class="page-lead">
					Web上で直接使えるWebアプリケーションおよび各種自作ツールの紹介ページです。
				</p>
			</div>

			<!-- Generative AI Notice Callout Box (Top / Above Tabs) -->
			<div class="ai-notice-box">
				<div class="ai-notice-header">
					<span class="ai-notice-badge">Information</span>
					<h2>生成AI使用表明</h2>
				</div>
				<p>
					当サイトで提供しているWebアプリケーションおよび掲載ツールの一部は、生成AI（AIコーディングアシスタント等）を活用して開発・検証を行いビルドされたものです。<br
					/>
					詳細は各Webアプリのページ、およびデスクトップアプリのGitHubリポジトリに記載してあります。
				</p>
			</div>

			<!-- Tools Tab Navigation Bar -->
			<div class="tools-tab-bar">
				<button
					id="tab-btn-scale"
					class="tools-tab active"
					type="button"
				>
					🎹 音楽スケール検索＆耳コピ逆引き (Webアプリ)
				</button>
				<button id="tab-btn-other" class="tools-tab" type="button">
					🖥️ デスクトップアプリ (ChordLaunchpad / Win11Optimizer)
				</button>
			</div>

			<!-- Tab Content 1: Scale Finder Web App (Top / Primary Tab) -->
			<div id="tools-panel-scale" class="tools-tab-panel active">
				<div class="tool-ai-credit">
					<span class="ai-badge">AI Development</span>
					<span>この「音楽スケール検索＆耳コピ逆引きツール」は、<strong>Gemini 3.6 Flash</strong> を使用して作成されました。</span>
				</div>
				<ScaleFinder />
			</div>

			<!-- Tab Content 2: Desktop Apps -->
			<div id="tools-panel-other" class="tools-tab-panel">
				<div class="other-tools-grid">
					<!-- ChordLaunchpad -->
					<article class="tool-card">
						<div class="card-tag">Desktop App</div>
						<h2>ChordLaunchpad</h2>
						<p>
							コード進行を入力し、テンプレート分析・リアルタイム試聴・MIDIファイルの書き出しまでワンストップで扱えるデスクトップアプリケーションです。
						</p>
						<div class="card-footer">
							<a
								href="https://github.com/stellorbit/ChordLaunchpad"
								target="_blank"
								rel="noopener noreferrer"
								class="tool-btn tool-btn--outline"
							>
								GitHub リポジトリを見る ↗
							</a>
						</div>
					</article>

					<!-- Win11Optimizer -->
					<article class="tool-card">
						<div class="card-tag">System Utility</div>
						<h2>Win11Optimizer Ver.2026.04</h2>
						<p>
							Windows 11
							のプライバシー・UI設定を調整できるチューニングツールです。<br
							/>
							最新バージョンでは機能を厳選し、パフォーマンス向上・テレメトリー無効化・クラウド連携抑制に特化しています。
						</p>
						<div class="card-footer">
							<a
								href="https://github.com/stellorbit/Win11Optimizer"
								target="_blank"
								rel="noopener noreferrer"
								class="tool-btn tool-btn--outline"
							>
								GitHub リポジトリを見る ↗
							</a>
						</div>
					</article>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<script>
	const tabScale = document.getElementById('tab-btn-scale')!;
	const tabOther = document.getElementById('tab-btn-other')!;
	const panelScale = document.getElementById('tools-panel-scale')!;
	const panelOther = document.getElementById('tools-panel-other')!;

	tabScale.addEventListener('click', () => {
		tabScale.classList.add('active');
		tabOther.classList.remove('active');
		panelScale.classList.add('active');
		panelOther.classList.remove('active');
	});

	tabOther.addEventListener('click', () => {
		tabOther.classList.add('active');
		tabScale.classList.remove('active');
		panelOther.classList.add('active');
		panelScale.classList.remove('active');
	});
</script>

<style>
	/* AI Notice Callout Box */
	.ai-notice-box {
		background: #ffffff;
		border: 1px solid var(--line);
		border-left: 4px solid var(--accent);
		border-radius: 16px;
		padding: 1.25rem 1.5rem;
		margin-bottom: 1.75rem;
		box-shadow: var(--shadow-soft);
	}

	.ai-notice-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}

	.ai-notice-badge {
		padding: 0.15rem 0.55rem;
		border-radius: 6px;
		background: rgba(176, 106, 67, 0.12);
		color: var(--accent-deep);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.ai-notice-header h2 {
		margin: 0;
		font-size: 1.15rem;
		color: var(--ink-strong);
	}

	.ai-notice-box p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--ink-soft);
		line-height: 1.65;
	}

	/* Tool AI Credit Banner */
	.tool-ai-credit {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		background: rgba(176, 106, 67, 0.06);
		border: 1px dashed var(--line);
		border-radius: 12px;
		padding: 0.65rem 1rem;
		margin-bottom: 1.25rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
		flex-wrap: wrap;
	}

	.ai-badge {
		padding: 0.15rem 0.5rem;
		border-radius: 6px;
		background: var(--accent);
		color: #ffffff;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	/* Tools Tab Navigation Bar */
	.tools-tab-bar {
		display: flex;
		gap: 0.75rem;
		border-bottom: 2px solid var(--line);
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.tools-tab {
		padding: 0.85rem 1.4rem;
		border: 1px solid transparent;
		border-bottom: none;
		border-radius: 14px 14px 0 0;
		background: rgba(252, 248, 242, 0.6);
		color: var(--ink-soft);
		font-size: 1.05rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.tools-tab:hover {
		background: rgba(176, 106, 67, 0.08);
		color: var(--ink-strong);
	}

	.tools-tab.active {
		background: var(--accent);
		color: #ffffff;
		box-shadow: 0 -4px 12px rgba(176, 106, 67, 0.25);
	}

	.tools-tab-panel {
		display: none;
	}

	.tools-tab-panel.active {
		display: block;
	}

	/* Other Tools Grid */
	.other-tools-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.5rem;
		margin-top: 1rem;
	}

	.tool-card {
		background: #ffffff;
		border: 1px solid var(--line);
		border-radius: 18px;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		box-shadow: var(--shadow-soft);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.tool-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow);
	}

	.card-tag {
		align-self: flex-start;
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
		background: rgba(176, 106, 67, 0.12);
		color: var(--accent-deep);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.75rem;
	}

	.tool-card h2 {
		margin: 0 0 0.75rem;
		font-size: 1.35rem;
		color: var(--ink-strong);
	}

	.tool-card p {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
		color: var(--ink-soft);
		line-height: 1.7;
	}

	.card-footer {
		margin-top: auto;
	}

	.tool-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 0.7rem 1.25rem;
		border-radius: 12px;
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.tool-btn--primary {
		background: var(--accent);
		color: #ffffff;
		box-shadow: 0 4px 12px rgba(176, 106, 67, 0.3);
	}

	.tool-btn--primary:hover {
		background: var(--accent-deep);
		transform: translateY(-1px);
	}

	.tool-btn--outline {
		background: #ffffff;
		border: 1px solid var(--line);
		color: var(--ink-strong);
	}

	.tool-btn--outline:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	@media (max-width: 768px) {
		.tools-tab-bar {
			flex-direction: column;
			gap: 0.5rem;
		}
		.tools-tab {
			border-radius: 12px;
			text-align: left;
		}
	}
</style>
